{
  "name": "mason-recipe-submissions",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SUBMISSION_RATE_LIMITER",
        "class_name": "SubmissionRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SubmissionRateLimiter"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://masonrecipes.github.io",
    "TURNSTILE_HOSTNAME": "masonrecipes.github.io"
  }
}
